generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id          Int      @id @default(autoincrement())
  name        String
  ownerName   String
  phone       String   @unique
  password    String
  address     String?
  plan        String   @default("trial")
  planExpiry  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products  Product[]
  customers Customer[]
  sales     Sale[]
}

model Product {
  id             Int      @id @default(autoincrement())
  businessId     Int
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  unit           String   @default("পিস")
  wholesalePrice Float    @default(0)
  retailPrice    Float    @default(0)
  stockQty       Float    @default(0)
  createdAt      DateTime @default(now())

  saleItems SaleItem[]
}

model Customer {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  address    String?
  type       String   @default("retail")
  due        Float    @default(0)
  createdAt  DateTime @default(now())

  sales Sale[]
}

model Sale {
  id          Int      @id @default(autoincrement())
  businessId  Int
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceNo   String
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  type        String   @default("retail")
  subtotal    Float    @default(0)
  discount    Float    @default(0)
  total       Float    @default(0)
  paid        Float    @default(0)
  due         Float    @default(0)
  paymentMethod String @default("cash")
  saleDate    DateTime @default(now())

  items SaleItem[]

  @@unique([businessId, invoiceNo])
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  qty         Float
  rate        Float
  total       Float
}